---
# MANAGED BY ANSIBLE (role: wazuh_stack)
#
# Names the certificates the generator produces. The values are Docker service
# names, not IP addresses, because all TLS here is between containers on the
# compose network — which is exactly why this file is identical on a laptop and
# on a VPS.
#
# The generator also derives file ownership from this manifest: entries under
# `server` get uid 999 (the manager), the rest get 1000 (indexer/dashboard).
nodes:
  indexer:
    - name: wazuh.indexer
      ip: wazuh.indexer

  server:
    - name: wazuh.manager
      ip: wazuh.manager

  dashboard:
    - name: wazuh.dashboard
      ip: wazuh.dashboard
