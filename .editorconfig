root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Tabs are syntax in a Makefile, not style. A recipe line indented with spaces
# fails with "missing separator".
[Makefile]
indent_style = tab

[*.{tf,tfvars}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.sh]
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
